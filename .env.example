# ===== Django =====
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=support-pak.ru,www.support-pak.ru,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://support-pak.ru,https://www.support-pak.ru
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_HSTS_SECONDS=31536000

# ===== База данных =====
DB_NAME=device_hub
DB_USER=devicehub
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Для запуска postgres-контейнера (docker-compose)
POSTGRES_DB=device_hub
POSTGRES_USER=devicehub
POSTGRES_PASSWORD=change-me

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN

# ===== MQTT (основной брокер ПАК) =====
MQTT_BROKER=77.239.107.241
MQTT_PORT=1883
MQTT_USER=pak
MQTT_PASS=change-me
MQTT_TOPIC=#

# Отдельный брокер для суточных снимков осмотров (если он не тот же, что статусы)
MQTT_DAY_BROKER=
MQTT_DAY_PORT=1883
MQTT_DAY_USER=pak
MQTT_DAY_PASS=
MQTT_DAY_TOPICS=pak/day,client/day

# ===== SSH-доступ к устройствам =====
DEVICE_SSH_USER=terminal
DEVICE_SSH_PASSWORD=change-me
# Пароль sudo/root на ПАК, если он отличается от пароля входа по SSH.
# Пустое значение — sudo выполняется паролем входа (DEVICE_SSH_PASSWORD).
DEVICE_SSH_SUDO_PASSWORD=
# Дополнительные пароли (через запятую), если на разных киосках разные пароли
DEVICE_SSH_PASSWORDS=
